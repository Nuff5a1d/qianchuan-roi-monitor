{
  "manifest_version": 3,
  "name": "Kamisama - 全链路千川",
  "version": "1.3.4",
  "description": "Kamisama - 全链路千川：支持千川乘方/调控/全域推商品/推直播间 ROI、预算提醒、可用余额充值提醒、灰保过保监控，内置30分钟趋势总结报告（支持豆包/智谱/DeepSeek/通义AI分析）与五大渠道三层持久化推送。",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://qianchuan.jinritemai.com/*",
    "https://compass.jinritemai.com/*",
    "https://ad.oceanengine.com/*",
    "https://qyapi.weixin.qq.com/*",
    "https://www.pushplus.plus/*",
    "https://oapi.dingtalk.com/*",
    "https://open.feishu.cn/*",
    "https://api.day.app/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.openai.com/*",
    "https://www.kamisama.si/*",
    "https://kamisama.si/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开/收起 ROI 实时监控面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qianchuan.jinritemai.com/*",
        "https://compass.jinritemai.com/*",
        "https://ad.oceanengine.com/*",
        "file:///*demo.html"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/wechat-qr.jpg"
      ],
      "matches": [
        "https://qianchuan.jinritemai.com/*",
        "https://compass.jinritemai.com/*",
        "https://ad.oceanengine.com/*",
        "file://*/*"
      ]
    }
  ]
}
